#!/bin/sh
# dsh-phone-bridge-ctl — 管理「DSH 直接调用手机工具链」的常驻服务与配置
#
#   status | health | enable | disable | config-on | config-off | config-status | log | tools
#
# 背景：用户要求「启动 DSH 让 DSH 操作手机，能够直接调用相关工具链」。
# 本包把 MCP 服务做成独立 launchd daemon（RunAtLoad + KeepAlive），
# 并在 DSH 的 cordis.patch.yml 里幂等注册 MCP 客户端；因此终端敲 dsh、
# 点桌面 APP 图标、或 launchd 自动拉起 DSH，都能直接用 mcp__ios__* 工具。
#
# 关闭方式：dsh-phone-bridge-ctl config-off && dsh-phone-bridge-ctl disable
JB=/var/jb
LABEL=dev.airdevs.dsh.phone-bridge
PLIST="$JB/Library/LaunchDaemons/$LABEL.plist"
BR="$JB/usr/lib/dsh-phone-bridge"
NODE_SAFE="$JB/usr/lib/dsh/node-safe"
PORT="${DSH_BRIDGE_PORT:-8091}"
NATIVE_PORT="${DSH_IOS_MCP_PORT:-8090}"
DSHHOME="${DSH_HOME:-$JB/var/mobile/.dsh}"
LOGDIR="$JB/var/log/dsh-app"

find_launchctl() {
    for c in "$JB/usr/bin/launchctl" "$JB/bin/launchctl" /usr/bin/launchctl /bin/launchctl; do
        [ -x "$c" ] && { printf '%s' "$c"; return 0; }
    done
    command -v launchctl 2>/dev/null || return 1
}
LC=$(find_launchctl 2>/dev/null || true)

# 用包内 node 发 HTTP，不依赖 curl / nc（Node 24 + A11 必须零 JIT）
health() {
    [ -x "$NODE_SAFE" ] || return 1
    "$NODE_SAFE" -e '
      const http=require("http");
      const req=http.get({host:"127.0.0.1",port:Number(process.argv[1]),path:"/health",timeout:1500},r=>{
        let b=""; r.on("data",c=>b+=c); r.on("end",()=>{
          let ok=false; try{ok=JSON.parse(b).status==="ok"}catch(_){}
          if(ok){process.stdout.write(b+"\n");process.exit(0)} process.exit(1);
        });
      });
      req.on("error",()=>process.exit(1));
      req.on("timeout",()=>{req.destroy();process.exit(1)});
    ' "$PORT" 2>/dev/null
}

bridge_pid() {
    if [ -n "$LC" ]; then
        P=$("$LC" list "$LABEL" 2>/dev/null | sed -n 's/^\([0-9][0-9]*\)[[:space:]].*/\1/p' | head -1)
        [ -n "$P" ] && [ "$P" != "0" ] && { printf '%s' "$P"; return 0; }
    fi
    for p in $(pgrep -f 'dsh-phone-bridge/server.cjs' 2>/dev/null); do printf '%s' "$p"; return 0; done
    return 1
}

do_bootstrap() {
    [ -f "$PLIST" ] || { echo "dsh-phone-bridge-ctl: 缺少 $PLIST" >&2; return 1; }
    [ -n "$LC" ] || { echo "dsh-phone-bridge-ctl: 找不到 launchctl" >&2; return 1; }
    "$LC" bootstrap system "$PLIST" >/dev/null 2>&1 || true
    "$LC" load -w "$PLIST" >/dev/null 2>&1 || true
    # 已加载但退出（或刚 bootstrap）时拉起来；不带 -k，避免踢掉正在跑的实例。
    "$LC" kickstart "system/$LABEL" >/dev/null 2>&1 || true
    "$LC" list "$LABEL" >/dev/null 2>&1
}
do_bootout() {
    [ -z "$LC" ] && return 0
    "$LC" bootout "system/$LABEL" >/dev/null 2>&1 && return 0
    "$LC" unload -w "$PLIST" >/dev/null 2>&1 && return 0
    "$LC" remove "$LABEL" >/dev/null 2>&1 && return 0
    return 0
}

config() {
    [ -x "$NODE_SAFE" ] && [ -f "$BR/ensure-config.cjs" ] || { echo "缺 ensure-config.cjs / node-safe" >&2; return 1; }
    case "$1" in
        off) mkdir -p "$DSHHOME" 2>/dev/null || true; : > "$DSHHOME/.phone-bridge-no-auto-config" 2>/dev/null || true ;;
        on)  rm -f "$DSHHOME/.phone-bridge-no-auto-config" 2>/dev/null || true ;;
    esac
    "$NODE_SAFE" "$BR/ensure-config.cjs" "$DSHHOME" "$1"
}

# 原生层启停（改文件名，respring 后生效）。上游 ios-mcp 的监听地址是
# INADDR_ANY(0.0.0.0:8090) 且无认证，不在可信局域网时可先停用，仅保留
# bridge 的 A 层工具。
native_toggle() {
    DL="$JB/Library/MobileSubstrate/DynamicLibraries"
    case "$1" in
        off)
            if [ -f "$DL/dsh-ios-control.dylib" ]; then
                mv "$DL/dsh-ios-control.dylib" "$DL/dsh-ios-control.dylib.disabled"
                [ -f "$DL/dsh-ios-control.plist" ] && mv "$DL/dsh-ios-control.plist" "$DL/dsh-ios-control.plist.disabled"
                echo "原生层已停用；respring（或重启越狱）后 8090 不再监听。"
            else
                echo "原生层已是停用状态。"
            fi ;;
        on)
            if [ -f "$DL/dsh-ios-control.dylib.disabled" ]; then
                mv "$DL/dsh-ios-control.dylib.disabled" "$DL/dsh-ios-control.dylib"
                [ -f "$DL/dsh-ios-control.plist.disabled" ] && mv "$DL/dsh-ios-control.plist.disabled" "$DL/dsh-ios-control.plist"
                echo "原生层已启用；respring（或重启越狱）后生效。"
            else
                echo "原生层已是启用状态。"
            fi ;;
    esac
}

# 原生层（SpringBoard 内的 ios-mcp，8090）是否已加载。只有 respring/重启后
# 才会出现；bridge 的 B 层工具（点按/滑动/输入/截图/AX 树）依赖它。
native_up() {
    [ -x "$NODE_SAFE" ] || return 1
    "$NODE_SAFE" -e '
      const net=require("net");
      const s=net.connect({host:"127.0.0.1",port:Number(process.argv[1])});
      const done=(ok)=>{try{s.destroy()}catch(_){};process.exit(ok?0:1)};
      s.setTimeout(1200,()=>done(false));
      s.on("connect",()=>done(true));
      s.on("error",()=>done(false));
    ' "$NATIVE_PORT"
}

# 直接在设备上列出当前可用工具（诊断用；DSH 自己会通过 MCP 拿同一份列表）
list_tools() {
    [ -x "$NODE_SAFE" ] || return 1
    "$NODE_SAFE" -e '
      const http=require("http");
      const body=JSON.stringify({jsonrpc:"2.0",id:1,method:"tools/list",params:{}});
      const req=http.request({host:"127.0.0.1",port:Number(process.argv[1]),path:"/mcp",method:"POST",
        headers:{"Content-Type":"application/json","Accept":"application/json, text/event-stream",
                 "MCP-Protocol-Version":"2025-11-25","Content-Length":Buffer.byteLength(body)},timeout:5000},r=>{
        let b="";r.on("data",c=>b+=c);r.on("end",()=>{
          try{const t=JSON.parse(b).result.tools||[];console.log("工具数: "+t.length);t.forEach(x=>console.log("  "+x.name))}
          catch(_){console.log("解析失败: "+b.slice(0,300));process.exit(1)}
        });
      });
      req.on("error",e=>{console.log("连接失败: "+e.message);process.exit(1)});
      req.on("timeout",()=>{req.destroy();process.exit(1)});
      req.write(body);req.end();
    ' "$PORT"
}

# +ios24.8：HUD 可见性诊断。真机「HUD 完全不可见」最难的是判断到底卡在哪
# 一层（dylib 没注入 / 没 respring / 文件读不到 / 桥没写事件 / 被其它插件盖住）。
# 逐项列出证据，用户照着看一眼就能定位。
hud_diag() {
    DL="$JB/Library/MobileSubstrate/DynamicLibraries"
    HUDJSON="/var/mobile/Library/DSH/hud.json"
    ACK="/var/mobile/Library/DSH/hud.ack.json"
    echo "=== HUD 实时进度诊断 ==="
    if [ -f "$DL/dsh-ios-hud.dylib" ]; then
        echo "dylib:   已安装 ($DL/dsh-ios-hud.dylib)"
    else
        echo "dylib:   缺失！本包不完整，重装 deb"
    fi
    if [ -f "$DL/dsh-ios-hud.plist" ]; then echo "plist:   已安装（Filter=SpringBoard）"; else echo "plist:   缺失"; fi
    if [ -f "$ACK" ]; then
        echo "注入:    已加载（HUD dylib 写回了 ack）:"
        sed 's/^/         /' "$ACK" 2>/dev/null || true
    else
        echo "注入:    未确认（无 hud.ack.json）—— 多半是没 respring，或 ElleKit 未加载该 dylib"
        echo "         → 先 respring 一次；仍无则看 jailbreak 日志里 dsh-ios-hud 的注入错误"
    fi
    if [ -f "$HUDJSON" ]; then
        echo "状态文件: 存在 ($HUDJSON)"
        echo "         $(head -c 300 "$HUDJSON" 2>/dev/null)"
    else
        echo "状态文件: 不存在 —— bridge 没写（服务没起 / 权限问题）"
    fi
    # 事件流健康：/progress?since=0 能返回、seq>0 就说明桥在推事件
    if [ -x "$NODE_SAFE" ]; then
        PR=$("$NODE_SAFE" -e '
          const http=require("http");
          const req=http.get({host:"127.0.0.1",port:Number(process.argv[1]),path:"/progress?since=0",timeout:1500},r=>{
            let b="";r.on("data",c=>b+=c);r.on("end",()=>{try{const j=JSON.parse(b);console.log("seq="+j.seq+" events="+j.events.length+" sse="+j.sse_subscribers+" state="+(j.snapshot&&j.snapshot.state))}catch(_){console.log("解析失败")}});
          });
          req.on("error",()=>console.log("不可连"));
          req.on("timeout",()=>{req.destroy();console.log("超时")});
        ' "$PORT" 2>/dev/null)
        echo "事件流:  $PR"
    fi
    echo "提示:    进度主通道在 DSH 界面右下角的常驻面板（不依赖本 HUD）；"
    echo "         本 HUD 只是切到别的 App 时的跨 App 兜底。若面板也不动，跑 status / config-status。"
}

case "${1:-status}" in
    health)
        health && exit 0 || { echo "bridge 127.0.0.1:$PORT/health 不可连"; exit 1; } ;;
    hud) hud_diag ;;
    status)
        echo "=== dsh-phone-bridge 状态 ==="
        P=$(bridge_pid 2>/dev/null || true)
        if [ -n "$P" ]; then echo "daemon:  已运行 (PID=$P, launchd KeepAlive)"; else echo "daemon:  未运行"; fi
        if H=$(health 2>/dev/null); then echo "health:  $H"; else echo "health:  不可连（127.0.0.1:$PORT）"; fi
        if [ -f "$JB/Library/MobileSubstrate/DynamicLibraries/dsh-ios-control.dylib" ]; then
            echo "native:  已安装（dylib 在位）"
        else
            echo "native:  已停用（dylib.disabled）"
        fi
        if native_up 2>/dev/null; then echo "listen:  已加载（127.0.0.1:$NATIVE_PORT，点按/滑动/输入/截图可用）"; else echo "listen:  未加载（respring 或重启越狱后生效；当前仅本机 A 层工具）"; fi
        if [ -f "$DSHHOME/.phone-bridge-no-auto-config" ]; then echo "auto:    已关闭（删掉 $DSHHOME/.phone-bridge-no-auto-config 或 config-on 恢复）"; else echo "auto:    开启（每次启动 DSH 幂等注册 MCP）"; fi
        config status 2>/dev/null | "$NODE_SAFE" -e 'let s="";process.stdin.on("data",c=>s+=c);process.stdin.on("end",()=>{try{const j=JSON.parse(s);j.results.forEach(r=>console.log("patch:   "+r.file+" registered="+r.registered+" valid="+r.valid))}catch(_){}})' 2>/dev/null || true
        ;;
    native)  native_up && echo "native 8090 已加载" || { echo "native 8090 未加载（respring 一次）"; exit 1; } ;;
    native-on)  native_toggle on ;;
    native-off) native_toggle off ;;
    enable)  do_bootstrap && echo "phone-bridge 已启用（RunAtLoad + KeepAlive）" || echo "启用未即时生效，越狱重启后会自动 RunAtLoad" ;;
    disable) do_bootout && echo "phone-bridge 已停用" ;;
    config-on)     config on ;;
    config-off)    config off ;;
    config-status) config status ;;
    log)
        for f in "$LOGDIR/phone-bridge.err.log" "$LOGDIR/phone-bridge.out.log"; do
            [ -f "$f" ] && { echo "--- $f ---"; tail -40 "$f"; }
        done ;;
    tools)   list_tools ;;
    *) echo "用法: dsh-phone-bridge-ctl status|health|hud|native|native-on|native-off|enable|disable|config-on|config-off|config-status|log|tools" >&2; exit 64 ;;
esac
