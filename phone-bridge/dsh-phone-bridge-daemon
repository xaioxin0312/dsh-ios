#!/bin/sh
# dsh-phone-bridge-daemon — launchd 前台入口（绝不 fork / daemonize）
#
# 由 dev.airdevs.dsh.phone-bridge.plist 以 mobile 身份拉起，RunAtLoad +
# KeepAlive，因此「终端被杀 / DSH 重启 / bridge 崩溃」后工具链都还在。
#
# 只做一件事：exec 进纯 Node 的 MCP server，零 JIT 档（A11 上默认档的 JIT
# 编译会 SIGBUS），exec 保证 launchd 管住唯一 PID。
#
# +ios24.6：不再手写 --no-expose-wasm（Node 24 / V8 13.x 已删除该 flag，
# 传了直接 `bad option` 退出 9，daemon 永远起不来），统一走 node-safe。
# MCP 注册由 dsh wrapper 在每次启动 DSH 时以 mobile 身份幂等完成，daemon
# 本身仍绝不写 $DSH_HOME；日志统一放 jbroot 系统日志区。
JB=/var/jb
D="$JB/usr/lib/dsh"
BR="$JB/usr/lib/dsh-phone-bridge"
NODE_SAFE="$D/node-safe"
HOME="${HOME:-/var/mobile}"; export HOME
DSH_HOME="${DSH_HOME:-$JB/var/mobile/.dsh}"; export DSH_HOME
PATH="$JB/usr/bin:$JB/bin:/usr/bin:/bin:/usr/sbin:/sbin"; export PATH
mkdir -p "$JB/var/log/dsh-app" 2>/dev/null || true

exec "$NODE_SAFE" --expose-internals "$BR/server.cjs"
