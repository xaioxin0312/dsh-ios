<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>dev.airdevs.dsh.agent</string>
	<key>ProgramArguments</key>
	<array>
		<string>/var/jb/usr/bin/dsh-autostart-agent</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>
	<key>LimitLoadToSessionType</key>
	<string>Aqua</string>
	<key>ThrottleInterval</key>
	<integer>15</integer>
	<key>ProcessType</key>
	<string>Background</string>
	<key>WorkingDirectory</key>
	<string>/var/mobile</string>
	<key>StandardOutPath</key>
	<string>/var/jb/var/log/dsh-app/agent.out.log</string>
	<key>StandardErrorPath</key>
	<string>/var/jb/var/log/dsh-app/agent.err.log</string>
</dict>
</plist>
