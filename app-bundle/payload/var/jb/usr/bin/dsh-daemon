#!/bin/sh
# dsh-daemon — launchd 前台入口（绝不 fork / daemonize）。
# launchd 通过 KeepAlive 监视这一个 PID；进程被 jetsam 杀掉后立即重拉。
#
# 所有环境变量由 dev.airdevs.dsh.plist 的 EnvironmentVariables 提供，
# 这里再兜底一次（万一某台设备的 launchd 不注入 env）。
JB=/var/jb
export HOME="${HOME:-/var/mobile}"
export DSH_HOME="${DSH_HOME:-$JB/var/mobile/.dsh}"
export PATH="$JB/usr/bin:$JB/bin:/usr/bin:/bin:/usr/sbin:/sbin"
export NODE_PATH="${NODE_PATH:-$JB/usr/lib/dsh/node_modules}"
export PNPM_HOME="$DSH_HOME/pnpm"
export XDG_DATA_HOME="$DSH_HOME/pnpm-data"
export XDG_CACHE_HOME="$DSH_HOME/pnpm-cache"
export npm_config_cache="$DSH_HOME/npm-cache"
export npm_config_store_dir="$DSH_HOME/pnpm/store"
export NODE_OPTIONS="${NODE_OPTIONS:---max-old-space-size=384}"

# 固定 loopback token —— 与固定 token 补丁 / 状态文件 / 原生 App 缺省值一致。
# rc.3 的 processLaunchToken() 每次随机生成 token，而原生 App 用静态值，
# 二者不一致就会 401、前端 JS / 插件 / 工作区 / 对话全部不加载。
export DSH_WEB_TOKEN="${DSH_WEB_TOKEN:-dshios-fixed-token-8f3a2c}"

# 日志与运行时状态写在 jbroot 系统日志区。绝不 mkdir/chown/chmod $DSH_HOME 里的任何
# 东西 —— 用户的对话、工作区、插件、cordis.patch.yml、profiles/* 一律不碰。
LOGDIR="$JB/var/log/dsh-app"
mkdir -p "$LOGDIR" 2>/dev/null || true

# +ios24.11：动态端口，避免 3080 被别的进程占用导致 DSH 起不来。
# 策略：优先 DSH_WEB_PORT（plist 里是 3080）；若被占用则从 3081 起逐个探测，
# 选到空闲端口后原子写状态文件供原生 App / 设置页读取。绝大多数设备 3080 空闲，
# 行为与旧版完全一致；仅冲突时自动换端口，不碰 $DSH_HOME、不改终端启动方式。
PORT_FILE="$LOGDIR/web-port"
TOKEN_FILE="$LOGDIR/web-token"
pick_port() {
    base="$1"
    # 用 node-safe 零 JIT 探测器（不依赖 nc / curl，A11 上不 SIGBUS）。
    probe="$JB/usr/lib/dsh/port-probe.cjs"
    if [ -f "$probe" ] && [ -x "$JB/usr/lib/dsh/node-safe" ]; then
        picked=$("$JB/usr/lib/dsh/node-safe" "$probe" "$base" 2>/dev/null)
        [ -n "$picked" ] && { echo "$picked"; return 0; }
    fi
    # 兜底：无探测器时沿用 base（保持旧行为），由 dsh web 自行报错。
    echo "$base"
}
PORT=$(pick_port "${DSH_WEB_PORT:-3080}")
export DSH_WEB_PORT="$PORT"
# 原子写端口/token 状态文件（tmp + mv），原生 App 每 500ms 可见一致值。
printf '%s' "$PORT" > "$PORT_FILE.tmp" 2>/dev/null && mv "$PORT_FILE.tmp" "$PORT_FILE" 2>/dev/null || true
printf '%s' "$DSH_WEB_TOKEN" > "$TOKEN_FILE.tmp" 2>/dev/null && mv "$TOKEN_FILE.tmp" "$TOKEN_FILE" 2>/dev/null || true
chmod 644 "$PORT_FILE" "$TOKEN_FILE" 2>/dev/null || true

# 旧版这里有一段 `while dsh-app-ctl ping; do sleep 30; done` 的「等别的 DSH
# 实例退出」待机循环，但 ping 把 401 也判为可连，一旦 3080 上有任何返回 401
# 的残留进程，launchd 管住的就是一个永远待机的 shell，DSH 本体再也起不来。
# 本包是唯一的 DSH 启动途径（点图标即用，不需要终端），因此直接 exec。

# 关键：launchd 管的是「这一个进程」，所以必须 exec，不能留一层 shell。
exec "$JB/usr/bin/dsh" web --no-open --port "$PORT"
